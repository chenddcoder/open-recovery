{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dmde-rs",
  "version": "0.1.0",
  "identifier": "cn.chenddcoder.dmde-rs",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "dmde-rs · 开源磁盘编辑器与数据恢复",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "shortDescription": "开源磁盘编辑器与数据恢复工具",
    "longDescription": "dmde-rs：只读磁盘浏览、分区表解析、FAT/exFAT/NTFS/ext/HFS+ 文件系统读取与删除文件恢复。"
  }
}
